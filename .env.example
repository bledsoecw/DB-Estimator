# JobTread Pave API. Create a grant at https://app.jobtread.com/grants
# The key is shown ONCE and begins with grant_
#
# Scope this grant to READS ONLY for v0.5 (see docs/ROADMAP.md 19.2).
# It must NOT carry updateCostType / updateCostCode / updateCatalog — an auditor
# that can rewrite the policy it audits against has no invariants.
JOBTREAD_GRANT_KEY=grant_xxxxxxxxxxxxxxxxxxxx
JOBTREAD_ORGANIZATION_ID=22PBAjem8SSC

# Optional. Defaults to https://api.jobtread.com/pave
# JOBTREAD_API_URL=https://api.jobtread.com/pave

# Scope review only (npm run scope). Create a key at https://console.anthropic.com
# and put a spending limit on it there. Not needed for the pricing checks, and
# not needed for `npm run scope -- <id> --dry-run`, which sends nothing.
# ANTHROPIC_API_KEY=sk-ant-...
#
# Only for a key scoped to the ORGANIZATION rather than to a workspace: the API
# refuses such a key unless every request names a workspace. Copy the id from
# Organization settings › Workspaces (it starts with wrkspc_). A key created
# inside a workspace needs no such line.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Writing to JobTread (npm run contingency -- --apply, npm run build-budget --
# --apply) needs a SECOND grant, with catalog and job write access, so the machine
# that drafts cannot write by accident. The read key above stays read-only. Leave
# this unset on any machine that only reads.
# JOBTREAD_WRITE_GRANT_KEY=grant_yyyyyyyyyyyyyyyyyyyy
